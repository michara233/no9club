{
  "name": "no9club-blog",
  "version": "0.0.0",
  "private": true,
  "hexo": {
    "version": "8.1.2"
  },
  "description": "no9club blog site built with the hexo-theme-redefine fork in the repository root.",
  "scripts": {
    "sync-theme": "node tools/sync-theme.mjs",
    "build": "npm run sync-theme && hexo clean && hexo generate && node tools/check-output-size.mjs",
    "dev": "npm run sync-theme && hexo clean && hexo server",
    "clean": "hexo clean",
    "new": "hexo new"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-cli": "^4.3.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-wordcount": "^6.0.1",
    "js-yaml": "^4.1.0"
  }
}
